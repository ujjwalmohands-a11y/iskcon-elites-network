generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

// ------------------------------------------------------
// 1. IAM & Security (Maps to Clerk Auth)
// ------------------------------------------------------
model User {
 id String @id @default(uuid())
 clerkId String @unique
 email String @unique
 role Role @default(USER)
 createdAt DateTime @default(now())

 // Audit Relations
 alumni Alumnus[]
 speakers Speaker[]
 testimonials Testimonial[]
}

enum Role {
 USER
 ADMIN
 SUPERADMIN
}

// ------------------------------------------------------
// 2. Core Domain Models
// ------------------------------------------------------
model Alumnus {
 id String @id @default(uuid())
 name String
 category String 
 cohort String
 bio String @db.Text
 avatarUrl String?
 videoUrl String?
 socialLinks Json? 

 addedById String
 addedBy User @relation(fields: [addedById], references: [id])
 createdAt DateTime @default(now())
}

model Speaker {
 id String @id @default(uuid())
 name String
 title String
 bio String @db.Text
 avatarUrl String?

 addedById String
 addedBy User @relation(fields: [addedById], references: [id])
 createdAt DateTime @default(now())
}

model Testimonial {
 id String @id @default(uuid())
 authorName String
 role String
 content String @db.Text
 videoUrl String?

 addedById String
 addedBy User @relation(fields: [addedById], references: [id])
 createdAt DateTime @default(now())
}
