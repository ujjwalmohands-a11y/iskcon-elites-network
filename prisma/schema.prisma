generator client {
 provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Alumnus {
 id String @id @default(uuid())
 name String
 category String 
 cohort String
 bio String @db.Text
 avatarUrl String?
 videoUrl String?
 socialLinks Json?
 createdAt DateTime @default(now())
}

model Speaker {
 id String @id @default(uuid())
 name String
 title String
 bio String @db.Text
 avatarUrl String?
 createdAt DateTime @default(now())
}

model Testimonial {
 id String @id @default(uuid())
 authorName String
 role String
 content String @db.Text
 videoUrl String?
 createdAt DateTime @default(now())
}
